# Supabase - For Database and Auth
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar API
# Follow steps to create a Service Account in Google Cloud Console
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Provide the private key as a single string replacing actual newlines with \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nKey\nHere\n-----END PRIVATE KEY-----\n"
# The ID of the specific calendar you want to manage (often your primary email, or a dedicated calendar ID)
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Resend - For Transactional Emails
# Get this from your Resend Dashboard -> API Keys
RESEND_API_KEY=re_123456789
# The email address you verified on Resend to send emails from
EMAIL_FROM=updates@domain.com
# Where booking notifications go (defaults to EMAIL_FROM)
ADMIN_EMAIL=

# mNotify - For SMS Notifications
# Get this from mNotify Dashboard -> API
MNOTIFY_API_KEY=your_mnotify_api_key_here
MNOTIFY_SENDER_ID=TACCBooking
# The admin's phone number to receive alerts
ADMIN_PHONE=0200000000

# Vercel Cron Secret (for the daily reminder job)
CRON_SECRET=your-random-secure-string

# Cloudflare Worker (workers/soulwinning): D1 + R2 for soul winning, songs and camp
# Server-to-Worker calls use the workers.dev address (Vercel IPs are blocked on the zone)
SW_API_SERVER_URL=https://soulwinning-api.your-account.workers.dev
# Must match the Worker's ADMIN_SECRET (wrangler secret put ADMIN_SECRET)
SW_API_ADMIN_SECRET=
NEXT_PUBLIC_SW_API_URL=https://sw-api.theairportcitychurch.com
NEXT_PUBLIC_SW_CAMPAIGN=gic

# Code-protected admin areas: signed cookies need a secret of 32+ characters
SW_COOKIE_SECRET=
SW_ADMIN_CODE=
GRACE_VIEWER_CODE=
GRACE_ADMIN_CODE=
GRACE_COOKIE_SECRET=

# Google Drive (Grace in Continuity photo backup)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Camp admin: comma-separated login emails that are always camp admins, so the
# first admin can get in before anyone is added on /admin/camp/staff
CAMP_ADMIN_EMAILS=
# Camp attendee sign-in: hashes sign-in codes and signs the session cookie.
# 32+ random characters. Changing it invalidates every attendee's code.
CAMP_SECRET=
# Paystack: the secret key lives only in the Worker
# (cd workers/soulwinning && npx wrangler secret put PAYSTACK_SECRET_KEY; .dev.vars locally).
# Set the Paystack webhook URL to https://<worker>.workers.dev/v1/camp/paystack/webhook
